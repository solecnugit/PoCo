{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "moduleResolution": "node",
      "esModuleInterop": true,
      "outDir": "./dist",
      "rootDir": ".",
      "strict": true,
      "sourceMap": true,
      "declaration": true,
      "resolveJsonModule": true,
      "lib": ["ES2020", "DOM"],
      "types": ["node"]
    },
    "include": ["src/**/*", "server.ts"],
    "exclude": ["node_modules", "dist"]
  }